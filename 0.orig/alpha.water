FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0; // Tubo começa cheio de ar

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.5;      // água entra 
    }

    outlet
    {
        type            zeroGradient;
    }

    tubo
    {
        // Parede do duto: a água "gruda" na parede (adesão)
        type            zeroGradient;
    }

    baseBox
    {
        type            zeroGradient;
    }
}