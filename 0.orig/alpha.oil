FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.oil;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// =============================================================================
// FRACAO VOLUMETRICA DO OLEO — Perfil de entrada para raiz ESTAVEL
// =============================================================================
// Q = 12.00 L/min | h_L = 16.559 mm | V = 0.2172 m/s
// Comprimento do duto: 1.0 m
// =============================================================================

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            codedFixedValue;
        value           uniform 0;
        name            alphaOilInletProfile;

        code
        #{
            // Interface na entrada: oleo abaixo, ar acima
            const scalar hL_target = 0.016559;   // [m]
            const scalar rOut      = 0.057500;           // [m]
            const scalar zIface    = -rOut + hL_target;    // = -0.040941 m

            const fvPatch& p = this->patch();
            scalarField alpha(p.size(), 0.0);

            forAll(p, faceI)
            {
                scalar zf = p.Cf()[faceI].z();
                alpha[faceI] = (zf < zIface) ? 1.0 : 0.0;
            }

            operator==(alpha);
        #};
    }

    outlet
    {
        type            zeroGradient;
    }

    parede_interna
    {
        type            zeroGradient;
    }

    parede_externa
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //