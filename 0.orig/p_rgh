FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    outlet
    {
        type            prghPressure;
        p               uniform 0;
        value           $internalField;
    }

    parede_interna
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    parede_externa
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    inlet_oil
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    inlet_air
    {
        type            totalPressure;
        p0              uniform 0;
        value           uniform 0;
    }
}