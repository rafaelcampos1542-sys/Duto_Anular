FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.00015; // Valor inicial baixo

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.00015;
    }
    outlet
    {
        type            zeroGradient;
    }
    parede_interna
    {
        type            kqRWallFunction;
        value           uniform 0.00015;
    }
    parede_externa
    {
        type            kqRWallFunction;
        value           uniform 0.00015;
    }
}