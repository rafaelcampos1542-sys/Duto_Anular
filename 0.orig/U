FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// =============================================================================
// CONDICAO DE ENTRADA — Perfil bifasico para raiz ESTAVEL de O&F (2023)
// =============================================================================
// Q = 12.00 L/min | h_L = 16.559 mm | V = 0.2172 m/s | Re = 14.0
// =============================================================================

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            velocityProfile;

        code
        #{
            const fvPatch& p = this->patch();
            const fvMesh& mesh = p.boundaryMesh().mesh();

            vectorField v(p.size(), vector(0,0,0));

            // Velocidades das fases (ajustadas para a raiz analitica)
            const scalar uOleo = 0.2172;   // [m/s] velocidade da fase oleo
            const scalar uAr   = 0.01;              // [m/s] velocidade minima do ar (evita estagnacao)

            // Procurar alpha.oil (nao alpha.water!)
            const volScalarField* alphaPtr =
                mesh.findObject<volScalarField>("alpha.oil");

            if (!alphaPtr)
            {
                // Fallback: se alpha.oil nao existe, assume so oleo
                forAll(v, faceI)
                {
                    v[faceI] = vector(0, uOleo, 0);
                }
            }
            else
            {
                const scalarField alphaPatch =
                    alphaPtr->boundaryField()[p.index()];

                forAll(v, faceI)
                {
                    if (faceI < alphaPatch.size())
                    {
                        scalar w = alphaPatch[faceI];  // peso da fase oleo
                        v[faceI] = vector(0, w*uOleo + (1.0 - w)*uAr, 0);
                    }
                    else
                    {
                        v[faceI] = vector(0, uOleo, 0);
                    }
                }
            }

            operator==(v);
        #};
    }

    outlet
    {
        type            zeroGradient;
    }

    parede_interna
    {
        type            noSlip;
    }

    parede_externa
    {
        type            noSlip;
    }
}

