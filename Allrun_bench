#!/bin/bash
cd "$(dirname "$0")" || exit 1
. $WM_PROJECT_DIR/bin/tools/RunFunctions

# ==============================================================================
# 1. GERAÇÃO DE MALHA (Executada uma única vez antes dos testes)
# ==============================================================================
echo "===================================="
echo " Preparando a Malha (snappyHexMesh) "
echo "===================================="

# Limpeza inicial completa
rm -rf 0 processor* constant/polyMesh log.* dynamicCode 2>/dev/null
cp -r 0.orig 0

# Execução das ferramentas de malha
runApplication blockMesh
#runApplication surfaceFeatureExtract
#runApplication snappyHexMesh -overwrite
runApplication checkMesh

# ==============================================================================
# 2. FUNÇÃO PARA RODAR BENCHMARK DE CADA CONFIGURAÇÃO
# ==============================================================================
runCase () {
    NP=$1
    LABEL=$2

    echo "------------------------------------"
    echo "Rodando benchmark: $LABEL ($NP núcleos)"
    echo "------------------------------------"
    
    # Limpeza do tempo do caso e decomposições anteriores
    rm -rf processor* 0 dynamicCode 2>/dev/null
    
    # Restaura condições de contorno limpas de 0.orig
    cp -r 0.orig 0

    # Aplica o setFields na malha serial ANTES de decompor
    setFields > log.setFields.${LABEL} 2>&1

    # Limpa resíduos temporários do snappy dentro do diretório 0
    #rm -f 0/cellLevel 0/pointLevel 0/surfaceIndex 0/level0Edge 0/cc* 2>/dev/null

    # Pré-compilação do codedBC em serial
    interIsoFoam -postProcess > /dev/null 2>&1 || true

    # Atualiza o número de subdomínios em decomposeParDict
    foamDictionary system/decomposeParDict \
        -entry numberOfSubdomains \
        -set $NP > /dev/null 2>&1

    # Decomposição em paralelo
    decomposePar -force > log.decomposePar.${LABEL} 2>&1

    # Checagem de integridade
    if [ ! -d "processor0" ]; then
        echo "❌ ERRO: decomposePar falhou para $LABEL!"
        exit 1
    fi

    TS=$(date +%H%M%S)

    # Execução do solver com limite de tempo (timeout de 5 minutos)
    timeout 5m mpirun --oversubscribe -np $NP --use-hwthread-cpus interIsoFoam -parallel \
        > log.interIsoFoam.${LABEL}_${TS} 2>&1

    echo "✓ Teste $LABEL concluído."
}

# ==============================================================================
# 3. BENCHMARK: CPU (GAMG)
# ==============================================================================
if [ -f "system/fvSolution.gamg.bak" ]; then
    echo "===================================="
    echo " Testando Solucionador: CPU (GAMG)  "
    echo "===================================="
    cp system/fvSolution.gamg.bak system/fvSolution

    runCase 4 cpu4_gamg
    runCase 8 cpu8_gamg
    runCase 14 cpu14_gamg
fi

# ==============================================================================
# 4. BENCHMARK: CPU (PETSc)
# ==============================================================================
if [ -f "system/fvSolution.petsc_cpu.bak" ]; then
    echo "===================================="
    echo " Testando Solucionador: CPU (PETSc) "
    echo "===================================="
    cp system/fvSolution.petsc_cpu.bak system/fvSolution

    runCase 4 cpu4_petsc
    runCase 8 cpu8_petsc
    runCase 14 cpu14_petsc
fi

# ==============================================================================
# 5. BENCHMARK: GPU (AmgX / PETSc GPU)
# ==============================================================================
if [ -f "system/fvSolution.amgx.bak" ]; then
    echo "===================================="
    echo " Testando Solucionador: GPU         "
    echo "===================================="
    cp system/fvSolution.amgx.bak system/fvSolution
    export CUDA_VISIBLE_DEVICES=0

    runCase 1 gpu1
    runCase 2 gpu2
    runCase 4 gpu4
fi

echo "===================================="
echo "🎉 Benchmark finalizado com sucesso!"
echo "===================================="