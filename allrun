#!/bin/bash
#===============================================================================
# ALLRUN — Execução automatizada do caso Canal Anular
# Integra: malha, inicialização, compilação BC, execução, reconstrução
# Suporta: GAMG | PETSc CPU | PETSc GPU
#===============================================================================
set -e

cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

# ── CONFIGURAÇÕES ──────────────────────────────────────────────────────────
SOLVER="petsc_cpu"        # gamg | petsc_cpu | petsc_gpu
NPROCS=""                 # deixe vazio para auto-detectar
END_TIME=""               # deixe vazio para usar controlDict
WRITE_INTERVAL=""         # deixe vazio para usar controlDict
POST_PROCESS=true         # rodar pós-processamento Python após simulação?

# Cores
RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[1;33m'
BLU='\033[0;34m'
NC='\033[0m'

log_info()  { echo -e "${BLU}[INFO]${NC} $1"; }
log_warn()  { echo -e "${YLW}[WARN]${NC} $1"; }
log_ok()    { echo -e "${GRN}[OK]${NC} $1"; }
log_error() { echo -e "${RED}[ERRO]${NC} $1"; }

# ── FUNÇÕES AUXILIARES ─────────────────────────────────────────────────────
verificar_pre_requisitos() {
    log_info "Verificando pré-requisitos..."

    # Verificar se 0.orig existe
    if [ ! -d "0.orig" ]; then
        log_warn "0.orig não encontrado. Criando a partir de 0/ ..."
        if [ -d "0" ]; then
            cp -r 0 0.orig
        else
            log_error "Diretório 0/ não encontrado. Abortando."
            exit 1
        fi
    fi

    # Verificar se blockMeshDict existe
    if [ ! -f "system/blockMeshDict" ]; then
        log_error "system/blockMeshDict não encontrado!"
        exit 1
    fi

    # Verificar se transportProperties existe
    if [ ! -f "constant/transportProperties" ]; then
        log_error "constant/transportProperties não encontrado!"
        exit 1
    fi

    log_ok "Pré-requisitos OK"
}

configurar_solver() {
    log_info "Configurando solver: $SOLVER"

    case "$SOLVER" in
        gamg)
            NPROCS=${NPROCS:-8}
            log_info "Modo: GAMG nativo (CPU) | $NPROCS cores"

            # Verificar se existe backup do fvSolution
            if [ -f "system/fvSolution.gamg.bak" ]; then
                cp system/fvSolution.gamg.bak system/fvSolution
                log_ok "fvSolution restaurado de .gamg.bak"
            else
                log_warn "system/fvSolution.gamg.bak não encontrado. Usando fvSolution atual."
            fi

            # Remover lib petscFoam do controlDict se existir
            if grep -q "petscFoam" system/controlDict 2>/dev/null; then
                sed -i '/petscFoam/d' system/controlDict
                log_info "Removida lib petscFoam do controlDict"
            fi
            ;;

        petsc_cpu)
            NPROCS=${NPROCS:-8}
            log_info "Modo: PETSc CPU | $NPROCS cores"

            if [ -f "system/fvSolution.petsc_cpu.bak" ]; then
                cp system/fvSolution.petsc_cpu.bak system/fvSolution
                log_ok "fvSolution restaurado de .petsc_cpu.bak"
            else
                log_warn "system/fvSolution.petsc_cpu.bak não encontrado."
            fi

            # Garantir que petscFoam está no controlDict
            if ! grep -q "petscFoam" system/controlDict 2>/dev/null; then
                # Adicionar libs se não existir
                if ! grep -q "^libs" system/controlDict; then
                    sed -i '/^\/\//a\
libs\
(\
    petscFoam\
);' system/controlDict
                else
                    sed -i '/libs/,/);/{/);/i\\    petscFoam
}' system/controlDict
                fi
                log_info "Adicionada lib petscFoam ao controlDict"
            fi
            ;;

        petsc_gpu)
            NPROCS=${NPROCS:-4}
            log_info "Modo: PETSc + GPU (AmgX) | $NPROCS cores"

            if [ -f "system/fvSolution.amgx.bak" ]; then
                cp system/fvSolution.amgx.bak system/fvSolution
                log_ok "fvSolution restaurado de .amgx.bak"
            else
                log_warn "system/fvSolution.amgx.bak não encontrado."
            fi

            # Verificar CUDA
            if ! command -v nvidia-smi &> /dev/null; then
                log_warn "nvidia-smi não encontrado. GPU pode não estar disponível."
            else
                log_info "GPUs detectadas:"
                nvidia-smi --query-gpu=name,memory.total --format=csv,noheader || true
            fi

            export CUDA_VISIBLE_DEVICES=0

            # Garantir petscFoam no controlDict
            if ! grep -q "petscFoam" system/controlDict 2>/dev/null; then
                if ! grep -q "^libs" system/controlDict; then
                    sed -i '/^\/\//a\
libs\
(\
    petscFoam\
);' system/controlDict
                fi
            fi
            ;;

        *)
            log_error "Solver desconhecido: $SOLVER"
            log_error "Opções válidas: gamg | petsc_cpu | petsc_gpu"
            exit 1
            ;;
    esac

    # Configurar decomposeParDict
    foamDictionary system/decomposeParDict \
        -entry numberOfSubdomains -set "$NPROCS" 2>/dev/null || \
        log_warn "Não foi possível atualizar decomposeParDict automaticamente"

    # Ajustar endTime e writeInterval se especificados
    if [ -n "$END_TIME" ]; then
        foamDictionary system/controlDict -entry endTime -set "$END_TIME"
        log_info "endTime ajustado para $END_TIME s"
    fi

    if [ -n "$WRITE_INTERVAL" ]; then
        foamDictionary system/controlDict -entry writeInterval -set "$WRITE_INTERVAL"
        log_info "writeInterval ajustado para $WRITE_INTERVAL s"
    fi
}

# ── WORKFLOW PRINCIPAL ──────────────────────────────────────────────────────
echo "======================================================================"
echo "  ALLRUN — Canal Anular (OpenFOAM v2312)"
echo "  Solver: $SOLVER | Cores: ${NPROCS:-auto}"
echo "======================================================================"

verificar_pre_requisitos
configurar_solver

# ── 1. LIMPEZA ─────────────────────────────────────────────────────────────
log_info "Limpando caso anterior..."
rm -rf 0 processor* constant/polyMesh log.* dynamicCode postProcessing

# ── 2. RESTAURAR CONDIÇÕES INICIAIS ────────────────────────────────────────
cp -r 0.orig 0
log_ok "Condições iniciais restauradas"

# ── 3. GERAR MALHA ─────────────────────────────────────────────────────────
log_info "Gerando malha com blockMesh..."
runApplication blockMesh

log_info "Verificando qualidade da malha..."
runApplication checkMesh

# Verificar se há erros graves na malha
if grep -q "Failed" log.checkMesh 2>/dev/null; then
    log_error "Malha com erros graves! Verifique log.checkMesh"
    log_warn "Continuando mesmo assim (pode falhar)..."
fi

# ── 4. INICIALIZAÇÃO FÍSICA ───────────────────────────────────────────────
log_info "Aplicando setFields..."
runApplication setFields

# ── 5. PRÉ-COMPILAR CODED BC ──────────────────────────────────────────────
log_info "Pré-compilando codedFixedValue (serial)..."
interIsoFoam -postProcess > /dev/null 2>&1 || true

# Verificar se dynamicCode foi gerado
if [ -d "dynamicCode" ]; then
    log_ok "DynamicCode compilado com sucesso"
else
    log_warn "DynamicCode não gerado (pode ser normal se não houver coded BC)"
fi

# ── 6. PARALELIZAR ─────────────────────────────────────────────────────────
log_info "Decompondo domínio em $NPROCS partições..."
runApplication decomposePar -force

# ── 7. EXECUTAR SIMULAÇÃO ─────────────────────────────────────────────────
log_info "Iniciando interIsoFoam em paralelo..."
log_info "Log: log.interIsoFoam | tail -f log.interIsoFoam para acompanhar"

mpirun --oversubscribe -np "$NPROCS" interIsoFoam -parallel > log.interIsoFoam 2>&1

# Verificar se a simulação terminou com sucesso
if grep -q "Finalising parallel run" log.interIsoFoam 2>/dev/null || \
   grep -q "End" log.interIsoFoam 2>/dev/null; then
    log_ok "Simulação finalizada com sucesso!"
else
    log_warn "Simulação pode ter sido interrompida. Verifique log.interIsoFoam"
fi

# ── 8. RECONSTRUÇÃO ────────────────────────────────────────────────────────
log_info "Reconstruindo caso serial..."
runApplication reconstructPar

# ── 9. PÓS-PROCESSAMENTO ──────────────────────────────────────────────────
touch case.foam

if [ "$POST_PROCESS" = true ]; then
    if [ -f "analisar_resultados.py" ]; then
        log_info "Executando pós-processamento Python..."
        python3 analisar_resultados.py || log_warn "Falha no pós-processamento Python"
    else
        log_warn "analisar_resultados.py não encontrado. Pule o pós-processamento."
    fi
fi

echo ""
echo "======================================================================"
echo "  EXECUÇÃO FINALIZADA"
echo "  Resultados em: $(ls -1d [0-9]* 2>/dev/null | tail -n 1)"
echo "  Para visualizar: paraview case.foam"
echo "======================================================================"
