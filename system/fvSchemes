FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// ************************************************************************* //

ddtSchemes
{
    // Euler: 1ª ordem, estável, baixo custo — ideal para VoF com GPU
    // Se precisar de 2ª ordem no tempo: trocar por CrankNicolson 0.9
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;

    // Limitador de gradiente para U: evita oscilações em interfaces VoF
    // cellLimited reduz transferências CPU↔GPU em regiões de alto gradiente
    grad(U)         cellLimited Gauss linear 1;
    grad(k)         cellLimited Gauss linear 1;
    grad(omega)     cellLimited Gauss linear 1;
}

divSchemes
{
    // ── Momento ──────────────────────────────────────────────────────────
    // linearUpwind com grad limitado: mais estável que o original
    // O grad(U) agora usa cellLimited (definido acima) linearUpwind grad(U)
    div(rhoPhi,U)       Gauss limitedLinearV 1;

    // ── VoF / alpha (CPU - MULES) ─────────────────────────────────────
    // Mantidos exatamente como estavam — corretos para interIsoFoam
    div(phi,alpha.oil)      Gauss vanLeer;
    div(phirb,alpha.oil)    Gauss interfaceCompression 1;

    // ── Tensão viscosa ────────────────────────────────────────────────
    // linear é suficiente e mais barato que esquemas de alta ordem aqui
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;

    // ── Turbulência ────────────────────────────────────────────────────
    // limitedLinear 1: bom equilíbrio estabilidade/precisão para k-omega
    div(phi,k)          Gauss limitedLinear 1;
    div(phi,omega)      Gauss limitedLinear 1;
}

laplacianSchemes
{
    // Malha ortogonal: usar 'uncorrected' economiza cálculo e acelera a execução
    default         Gauss linear uncorrected;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    // Consistente com laplacianSchemes uncorrected
    default         uncorrected;
}

wallDist
{
    // meshWave: eficiente, sem custo adicional na GPU
    method          meshWave;
}

// ************************************************************************* //