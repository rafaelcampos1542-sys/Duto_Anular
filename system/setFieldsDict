FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0 // Padrão: Ar
);

regions
(
    // Preenche a metade inferior do tubo com Água (z de -0.06 até 0)
    boxToCell
    {
        box (-0.06 -2.501 -0.06) (0.06 2.501 0);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

