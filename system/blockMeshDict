FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1;

// =========================================================================
// PARÂMETROS GEOMÉTRICOS (Ajuste aqui se necessário)
// =========================================================================
rIn      0.0375;                      // Raio interno [m]
rOut     0.0575;                      // Raio externo [m]
yMin    -0.5;                         // Entrada em Y [m]
yMax     0.5;                         // Saída em Y [m]

// Pontos médios trigonométricos para os arcos de 45 graus
rInMid   #calc "$rIn * 0.707106781";
rOutMid  #calc "$rOut * 0.707106781";
rInMidN  #calc "-1.0 * $rInMid";
rOutMidN #calc "-1.0 * $rOutMid";

rInN     #calc "-1.0 * $rIn";
rOutN    #calc "-1.0 * $rOut";

// =========================================================================
// DISCRETIZAÇÃO DA MALHA (Facilita o estudo de convergência de malha)
// =========================================================================
nAzim    20;    // Células por quadrante (Total perimetral = 80)
nRad     20;    // Células no gap radial (entre rIn e rOut)
nAxial  50;    // Células ao longo do duto (eixo Y)

vertices
(
    // --- Plano Y = yMin (-2.5) ---
    ( $rIn   $yMin  0       ) // 0
    ( 0      $yMin  $rIn    ) // 1
    ( $rInN  $yMin  0       ) // 2
    ( 0      $yMin  $rInN   ) // 3

    ( $rOut  $yMin  0       ) // 4
    ( 0      $yMin  $rOut   ) // 5
    ( $rOutN $yMin  0       ) // 6
    ( 0      $yMin  $rOutN  ) // 7

    // --- Plano Y = yMax (+2.5) ---
    ( $rIn   $yMax  0       ) // 8
    ( 0      $yMax  $rIn    ) // 9
    ( $rInN  $yMax  0       ) // 10
    ( 0      $yMax  $rInN   ) // 11

    ( $rOut  $yMax  0       ) // 12
    ( 0      $yMax  $rOut   ) // 13
    ( $rOutN $yMax  0       ) // 14
    ( 0      $yMax  $rOutN  ) // 15
);

blocks
(
    // Quadrante 1 (0 a 90 deg)
    hex (0 1 5 4 8 9 13 12) ($nAzim $nRad $nAxial) simpleGrading (1 1 1)

    // Quadrante 2 (90 a 180 deg)
    hex (1 2 6 5 9 10 14 13) ($nAzim $nRad $nAxial) simpleGrading (1 1 1)

    // Quadrante 3 (180 a 270 deg)
    hex (2 3 7 6 10 11 15 14) ($nAzim $nRad $nAxial) simpleGrading (1 1 1)

    // Quadrante 4 (270 a 360 deg)
    hex (3 0 4 7 11 8 12 15) ($nAzim $nRad $nAxial) simpleGrading (1 1 1)
);

edges
(
    // Arcos no plano Y = yMin
    arc 0 1 ($rInMid   $yMin $rInMid)
    arc 1 2 ($rInMidN  $yMin $rInMid)
    arc 2 3 ($rInMidN  $yMin $rInMidN)
    arc 3 0 ($rInMid   $yMin $rInMidN)

    arc 4 5 ($rOutMid  $yMin $rOutMid)
    arc 5 6 ($rOutMidN $yMin $rOutMid)
    arc 6 7 ($rOutMidN $yMin $rOutMidN)
    arc 7 4 ($rOutMid  $yMin $rOutMidN)

    // Arcos no plano Y = yMax
    arc 8 9   ($rInMid   $yMax $rInMid)
    arc 9 10  ($rInMidN  $yMax $rInMid)
    arc 10 11 ($rInMidN  $yMax $rInMidN)
    arc 11 8  ($rInMid   $yMax $rInMidN)

    arc 12 13 ($rOutMid  $yMax $rOutMid)
    arc 13 14 ($rOutMidN $yMax $rOutMid)
    arc 14 15 ($rOutMidN $yMax $rOutMidN)
    arc 15 12 ($rOutMid  $yMax $rOutMidN)
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 5 1)
            (1 5 6 2)
            (2 6 7 3)
            (3 7 4 0)
        );
    }

    outlet
    {
        type patch;
        faces
        (
            (8 9 13 12)
            (9 10 14 13)
            (10 11 15 14)
            (11 8 12 15)
        );
    }

    parede_interna
    {
        type wall;
        faces
        (
            (0 1 9 8)
            (1 2 10 9)
            (2 3 11 10)
            (3 0 8 11)
        );
    }

    parede_externa
    {
        type wall;
        faces
        (
            (4 12 13 5)
            (5 13 14 6)
            (6 14 15 7)
            (7 15 12 4)
        );
    }
);

