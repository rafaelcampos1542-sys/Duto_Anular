FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// ************************************************************************* //
solvers
{
    "alpha.water.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 2;
        cAlpha          1;
        MULESCorr       yes;
        nLimiterIter    8;
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }
    "pcorr.*"
    {
        solver          petsc;
        preconditioner  petsc;
        tolerance       1e-5;
        relTol          0;
        petsc
        {
            options { ksp_type cg; pc_type gamg; }
            caching
            {
                matrix { updateFrequency adaptive; }
                preconditioner { updateFrequency adaptive; }
            }
        }
    }
    p_rgh
    {
        solver          petsc;
        preconditioner  petsc;
        tolerance       1e-7;
        relTol          0.05;
        petsc
        {
            options { ksp_type cg; pc_type gamg; }
            caching
            {
                matrix { updateFrequency adaptive; }
                preconditioner { updateFrequency adaptive; }
            }
        }
    }
    p_rghFinal
    {
        $p_rgh;
        relTol  0;
    }
    U
    {
        solver          petsc;
        preconditioner  petsc;
        tolerance       1e-6;
        relTol          0;
        petsc
        {
            options { ksp_type bicg; pc_type bjacobi; }
            caching
            {
                matrix { updateFrequency adaptive; }
                preconditioner { updateFrequency adaptive; }
            }
        }
    }
    "(k|omega).*"
    {
        solver          petsc;
        preconditioner  petsc;
        tolerance       1e-8;
        relTol          0.1;
        petsc
        {
            options { ksp_type bicg; pc_type bjacobi; }
            caching
            {
                matrix { updateFrequency adaptive; }
                preconditioner { updateFrequency adaptive; }
            }
        }
    }
}
PIMPLE
{
    momentumPredictor       no;
    nOuterCorrectors        1;
    nCorrectors             3;
    nNonOrthogonalCorrectors 1;
    pRefCell                0;
    pRefValue               0;
}
relaxationFactors
{
    equations { ".*" 1; }
}
// *************************************************************************