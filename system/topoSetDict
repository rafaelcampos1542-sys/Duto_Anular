actions
(
    // Cria o inletFaces do zero
    {
        name    inletFaces;
        type    faceSet;
        action  new; // MUDAMOS DE 'add' PARA 'new'
        source  patchToFace;
        patch   baseBox;
    }
    {
        name    inletFaces;
        type    faceSet;
        action  subset;
        source  boxToFace;
        // Inlet (na extremidade y = -2.5)
        box (-0.06 -2.51 -0.06) (0.06 -2.49 0.06);

    }

    // Cria o outletFaces do zero
    {
        name    outletFaces;
        type    faceSet;
        action  new; // MUDAMOS DE 'add' PARA 'new'
        source  patchToFace;
        patch   baseBox;
    }
    {
        name    outletFaces;
        type    faceSet;
        action  subset;
        source  boxToFace;
        // Outlet (na extremidade y = +2.5)
        box (-0.06 2.49 -0.06) (0.06 2.51 0.06); // Margem maior para garantir captura
    }
);