FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// ************************************************************************* //

solvers
{
    "alpha.oil.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 2;    // ← era 1, aumentar ajuda a estabilizar
        cAlpha          1;
        icAlpha         0;    // ← clipping explícito 0-1
        MULESCorr       yes;
        nLimiterIter    8;    // ← era 5, mais iterações no limitador
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }

    "pcorr.*"
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-5;
        relTol          0;
        nCellsInCoarsestLevel 20;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-8;
        relTol          0;
        nCellsInCoarsestLevel 20;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0;
        nSweeps         1;
    }

    UFinal
    {
        $U;
        relTol          0;
    }

    "(k|omega).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        nSweeps         1;
    }
}

PIMPLE
{
    momentumPredictor       yes;
    nOuterCorrectors        2;
    nCorrectors             3;
    nNonOrthogonalCorrectors 0;
    pRefCell                0;
    pRefValue               0;
}

relaxationFactors
{
    equations { ".*" 1; }
}

// ************************************************************************* //
