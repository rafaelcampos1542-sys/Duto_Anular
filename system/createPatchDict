FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}

pointSync false;

patches
(
    {
        name inlet_oil;

        patchInfo
        {
            type patch;
        }

        constructFrom set;

        set inletOil;
    }

    {
        name inlet_air;

        patchInfo
        {
            type patch;
        }

        constructFrom set;

        set inletAir;
    }
);
