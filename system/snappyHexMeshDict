FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       false; // Desativado na fase de testes

geometry
{
    inlet.stl          { type triSurfaceMesh; name inlet;          transform { scale 0.001; } }
    outlet.stl         { type triSurfaceMesh; name outlet;         transform { scale 0.001; } }
    parede_interna.stl { type triSurfaceMesh; name parede_interna; transform { scale 0.001; } }
    parede_externa.stl { type triSurfaceMesh; name parede_externa; transform { scale 0.001; } }
};

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      3000000;
    minRefinementCells  10;
    nCellsBetweenLevels 2;

    features
    (
        { file "inlet.eMesh";          level 2; }
        { file "outlet.eMesh";         level 2; }
        { file "parede_interna.eMesh"; level 2; }
        { file "parede_externa.eMesh"; level 2; }
    );

    resolveFeatureAngle 30;
    allowFreeStandingZoneFaces true;

    refinementSurfaces
    {
        inlet          { level (2 2); patchInfo { type patch; } }
        outlet         { level (2 2); patchInfo { type patch; } }
        parede_interna { level (2 2); patchInfo { type wall;  } }
        parede_externa { level (2 2); patchInfo { type wall;  } }
    }

    refinementRegions {}

    // Ponto no meio da região do fluido (Raio médio r = 47.5 mm = 0.0475 m)
    locationInMesh (0 0 -0.0475);
}

snapControls
{
    nSmoothPatch        7;
    tolerance           1.2;
    nSolveIter          150;
    nRelaxIter          10;
    nFeatureSnapIter    10;

    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;
    expansionRatio      1.2;
    finalLayerThickness 0.1;
    minThickness        0.05;
    nGrow               0;
    featureAngle        130;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;

    layers {}
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.02;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.1;

    relaxed
    {
        maxNonOrtho 70;
    }
}

writeFlags ( scalarLevels );
mergeTolerance 1e-6;

// ************************************************************************* //