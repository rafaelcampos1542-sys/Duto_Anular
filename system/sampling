FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sample;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;
libs            (sampling);

writeControl    writeTime;
interpolationScheme cellPoint;
setFormat       csv;

fields          ( alpha.water U );

sets
{
    // Perfil vertical Z no meio do comprimento do tubo (y = 0 m)
    perfil_vertical_meio
    {
        type        lineCell;
        axis        z;
        start       (0 0 -0.0575);
        end         (0 0  0.0575);
        nPoints     200;
    }

    // Perfil vertical Z na saída do tubo (y = 2.5 m)
    perfil_vertical_saida
    {
        type        lineCell;
        axis        z;
        start       (0 2.5 -0.0575);
        end         (0 2.5  0.0575);
        nPoints     200;
    }
}

