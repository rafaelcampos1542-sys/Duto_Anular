FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sample;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;
libs            (sampling);

writeControl    writeTime;
interpolationScheme cellPoint;
setFormat       csv;

fields          ( alpha.oil U );

// ================================================================
// GEOMETRIA DO DUTO ANULAR (confirmada pelo blockMeshDict)
//   Eixo do duto: Y (de yMin = -1.5 ate yMax = +1.5)
//   Centro da secao transversal: (x, z) = (0, 0)
//   Raio interno: rIn = 0.0375 m  (tubo interno, SOLIDO)
//   Raio externo: rOut = 0.0575 m (parede do duto)
//
// ATENCAO: linhas em x=0, z variando ATRAVESSAM o tubo interno.
// O OpenFOAM nao amostra no solido, criando um "gap" nos dados
// entre z ≈ -rIn e z ≈ +rIn. O script de pos-processamento
// deve detectar esse gap e NAO interpolar atraves dele.
// ================================================================

sets
{
    // --- Meio do duto (y = 0) -----------------------------------
    // Mesma secao transversal da saida, apenas deslocada em Y.
    // Passa pelo tubo interno (gap esperado de ~75 mm).
    perfil_meio
    {
        type        uniform;
        axis        z;
        start       (0  0  -0.0575);   // x=0, y=0 (meio do duto), z=fundo
        end         (0  0   0.0575);   // x=0, y=0, z=topo
        nPoints     100;
    }

    // --- Saida do duto (y = 1.5) --------------------------------
    // Referencia: interface em z ≈ +0.055 m (perto da parede externa)
    perfil_saida
    {
        type        uniform;
        axis        z;
        start       (0  1.5  -0.0575);
        end         (0  1.5   0.0575);
        nPoints     100;
    }

    // --- Linha de debug (mesma posicao do meio) -----------------
    perfil_vertical_debug
    {
        type        polyLine;
        axis        z;
        points
        (
            (0  0  -0.0575)
            (0  0   0.0575)
        );
        nPoints     200;
    }

    // ============================================================
    // OPCAO ALTERNATIVA: amostragem SEM passar pelo tubo interno
    // ============================================================
    // Desloca a linha para x = 0.0475 m (meio do espaco anular).
    // NAO ha gap, mas a altura medida nao e exatamente a mesma
    // posicao angular da linha x=0 (pode diferir se o escoamento
    // nao for perfeitamente axisimetrico).
    // ============================================================
    /*
    perfil_meio_sem_gap
    {
        type        uniform;
        axis        z;
        // x = r_mid = (rIn + rOut)/2 = 0.0475 m
        // z_max = sqrt(rOut^2 - r_mid^2) = sqrt(0.0575^2 - 0.0475^2) ≈ 0.0323 m
        start       (0.0475  0  -0.0323);
        end         (0.0475  0   0.0323);
        nPoints     100;
    }
    */
}

