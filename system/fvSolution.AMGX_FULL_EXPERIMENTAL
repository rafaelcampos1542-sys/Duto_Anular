FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

// EXPERIMENTAL: esta variante testa AmgX também nas equações de transporte.
// Não deve ser adotada como configuração final antes de comparar:
// (1) convergência, (2) iterações, (3) resultado físico e (4) tempo total.

solvers
{
    "alpha.oil.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 2;
        cAlpha          1;
        MULESCorr       yes;
        nLimiterIter    8;
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }

    "pcorr.*"
    {
        solver          petsc;
        preconditioner  petsc;
        tolerance       1e-5;
        relTol          0;
        petsc
        {
            options { ksp_type cg; pc_type amgx; }
            caching
            {
                matrix { updateFrequency adaptive; }
                preconditioner { updateFrequency adaptive; }
            }
        }
    }

    p_rgh
    {
        solver          petsc;
        preconditioner  petsc;
        tolerance       1e-7;
        relTol          0.05;
        petsc
        {
            options { ksp_type cg; pc_type amgx; }
            caching
            {
                matrix { updateFrequency adaptive; }
                preconditioner { updateFrequency adaptive; }
            }
        }
    }

    p_rghFinal
    {
        $p_rgh;
        relTol 0;
    }

    U
    {
        solver          petsc;
        preconditioner  petsc;
        tolerance       1e-6;
        relTol          0.05;
        petsc
        {
            options { ksp_type bicg; pc_type amgx; }
            caching
            {
                matrix { updateFrequency adaptive; }
                preconditioner { updateFrequency adaptive; }
            }
        }
    }

    UFinal
    {
        $U;
        relTol 0;
    }

    "(k|omega).*"
    {
        solver          petsc;
        preconditioner  petsc;
        tolerance       1e-8;
        relTol          0.1;
        petsc
        {
            options { ksp_type bicg; pc_type amgx; }
            caching
            {
                matrix { updateFrequency adaptive; }
                preconditioner { updateFrequency adaptive; }
            }
        }
    }
}

PIMPLE
{
    momentumPredictor        yes;
    nOuterCorrectors         2;
    nCorrectors              3;
    nNonOrthogonalCorrectors 0;
    pRefCell                 0;
    pRefValue                0;
}

relaxationFactors
{
    equations { ".*" 1; }
}

