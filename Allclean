#!/bin/sh
cd "${0%/*}" || exit

# --- CONFIGURAÇÕES ---
LIMITE_TAMANHO_MB=50

get_size() {
    du -sm . | cut -f1
}

# 1. Checar resultados
HAS_RESULTS=false
if ls -d [1-9]* [0-9].[0-9]* 2>/dev/null | grep -q .; then
    HAS_RESULTS=true
fi

# 2. Backup decisório
if [ "$HAS_RESULTS" = true ]; then
    TAMANHO_ATUAL=$(get_size)
    echo "Tamanho atual do caso: ${TAMANHO_ATUAL}MB"

    if [ "$TAMANHO_ATUAL" -gt "$LIMITE_TAMANHO_MB" ]; then
        BACKUP="backup_$(date +%Y%m%d_%H%M%S)"
        echo "Gerando backup em $BACKUP/..."
        mkdir -p "$BACKUP"

        cp -r [1-9]* [0-9].[0-9]* "$BACKUP/" 2>/dev/null || true
        cp log.*                   "$BACKUP/" 2>/dev/null || true
        cp system/fvSolution       "$BACKUP/fvSolution.usado" 2>/dev/null || true
        cp system/fvSchemes        "$BACKUP/fvSchemes.usado"  2>/dev/null || true
        cp system/controlDict      "$BACKUP/controlDict.usado" 2>/dev/null || true

        # Criar case.foam dentro do backup para abrir no ParaView
        touch "$BACKUP/case.foam"

        echo "Backup salvo em $BACKUP/ (${TAMANHO_ATUAL}MB)"
    else
        echo "Caso pequeno (${TAMANHO_ATUAL}MB < ${LIMITE_TAMANHO_MB}MB). Pulando backup."
    fi
else
    echo "Nenhum resultado encontrado. Pulando backup."
fi

# 3. Limpeza
echo "Limpando ambiente..."
rm -rf [1-9]* [0-9].[0-9]*
rm -rf processor*
rm -rf 0
cp -r 0.orig 0 2>/dev/null || echo "Aviso: 0.orig não encontrado."
rm -f log.*
rm -f *.foam
touch case.foam

echo "Ambiente pronto para nova simulação!"