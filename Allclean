#!/bin/bash
# Allclean — limpeza segura do caso Canal Anular.
# Mantém 0.orig/ e os arquivos de configuração do caso.
set -euo pipefail

CASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$CASE_DIR"

RED='\033[0;31m'; GRN='\033[0;32m'; YLW='\033[1;33m'; NC='\033[0m'
info(){ echo -e "\033[0;34m[INFO]\033[0m $*"; }
ok(){ echo -e "${GRN}[OK]${NC} $*"; }
warn(){ echo -e "${YLW}[AVISO]${NC} $*"; }
err(){ echo -e "${RED}[ERRO]${NC} $*"; }

if [[ ! -d 0.orig ]]; then
    err "0.orig/ não existe. Limpeza abortada para evitar perda de condições iniciais."
    exit 1
fi

info "Removendo resultados, logs, decomposição e malha..."

rm -rf processor* dynamicCode postProcessing \
    log.* *.foam 2>/dev/null || true

find . -maxdepth 1 -type d -regextype posix-extended \
    -regex './[0-9]+(\.[0-9]+)?' -exec rm -rf {} + 2>/dev/null || true

rm -rf 0 2>/dev/null || true
cp -r 0.orig 0

ok "Caso limpo e 0/ restaurado a partir de 0.orig/."
