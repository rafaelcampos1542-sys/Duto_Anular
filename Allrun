#!/bin/bash

# Allrun — orquestrador único do Canal Anular / OpenFOAM v2312

source /usr/lib/openfoam/openfoam2312/etc/bashrc

export FOAM_LD_LIBRARY_PATH="${FOAM_LD_LIBRARY_PATH:-$FOAM_LIBBIN:$FOAM_USER_LIBBIN:$FOAM_SITE_LIBBIN}"
export DYLD_LIBRARY_PATH="${DYLD_LIBRARY_PATH:-}"

set -e

CASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$CASE_DIR"

cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

RED='\033[0;31m'; GRN='\033[0;32m'; YLW='\033[1;33m'
BLU='\033[0;34m'; CYN='\033[0;36m'; NC='\033[0m'

info(){ echo -e "${BLU}[INFO]${NC} $*"; }
ok(){ echo -e "${GRN}[OK]${NC} $*"; }
warn(){ echo -e "${YLW}[AVISO]${NC} $*"; }
err(){ echo -e "${RED}[ERRO]${NC} $*"; }

PYTHON="${PYTHON:-$CASE_DIR/venv/bin/python}"
if [[ ! -x "$PYTHON" ]]; then PYTHON="$(command -v python3 || true)"; fi

source_foam() {
    if [[ -n "${WM_PROJECT_DIR:-}" && -f "$WM_PROJECT_DIR/bin/tools/RunFunctions" ]]; then
        # shellcheck disable=SC1090
        source "$WM_PROJECT_DIR/bin/tools/RunFunctions"
    fi
    if ! command -v blockMesh >/dev/null 2>&1; then
        err "OpenFOAM não está carregado. Execute: source <OpenFOAM>/etc/bashrc"
        exit 1
    fi
}

need_python() {
    [[ -n "$PYTHON" && -x "$PYTHON" ]] || {
        err "Python não encontrado. Crie/ative o venv ou defina PYTHON=/caminho/python."
        exit 1
    }
}

help() {
cat <<'EOF'
======================================================================
 WORKFLOW CANAL ANULAR — OpenFOAM v2312
======================================================================

Uso:
  ./Allrun <comando> [opções]

Comandos:
  condicoes [Q]              Calcula BCs e grava no caso.
  clean                      Limpa resultados, preservando 0.orig.
  mesh                       blockMesh + checkMesh.
  init                       Restaura 0 e executa setFields.
  run [solver] [tempo]      Executa simulação.
  run5 [solver]              Atalho para 5 s físicos.
  post                       Sampling + resultados + diagnóstico.
  compare                    Compara CFD x analítico.
  full [Q] [solver] [tempo] Pipeline completo.
  status                     Mostra estado do caso.
  help                       Mostra esta ajuda.

Exemplos:
  ./Allrun condicoes 35
  ./Allrun full 35 petsc_cpu 5
  ./Allrun run gamg
  ./Allrun run petsc_cpu 5
  ./Allrun run5 petsc_cpu
  ./Allrun post
  ./Allrun compare
  ./Allrun status

Solvers aceitos:
  gamg
  petsc_cpu
  petsc_gpu

Observação:
  Q padrão do pipeline = 35 L/min.
  Tempo padrão de run sem argumento = endTime do controlDict.
EOF
}

status() {
    echo ""
    echo "================ STATUS DO CASO ================"
    [[ -d constant/polyMesh ]] && echo "Malha:              OK" || echo "Malha:              AUSENTE"
    [[ -d 0 ]] && echo "Condições 0/:        OK" || echo "Condições 0/:        AUSENTE"
    [[ -d 0.orig ]] && echo "Backup 0.orig/:      OK" || echo "Backup 0.orig/:      AUSENTE"

    local n
    n=$(find . -maxdepth 1 -type d -regextype posix-extended \
        -regex './[0-9]+(\.[0-9]+)?' | wc -l)
    echo "Tempos escritos:     $n"

    local latest
    latest=$(find . -maxdepth 1 -type d -regextype posix-extended \
        -regex './[0-9]+(\.[0-9]+)?' -printf '%f\n' 2>/dev/null |
        sort -V | tail -1 || true)
    echo "Último tempo:        ${latest:-N/A}"

    [[ -d processor0 ]] && echo "Decomposto:          SIM" || echo "Decomposto:          NÃO"
    [[ -f resultados_hL.csv ]] && echo "Resultados CSV:      OK" || echo "Resultados CSV:      AUSENTE"
    [[ -f comparacao_analitico_cfd.png ]] && echo "Comparação:          OK" || echo "Comparação:          AUSENTE"
    echo "================================================="
}

condicoes() {
    need_python
    local q="${1:-35}"
    info "Calculando condições para Q=${q} L/min..."
    "$PYTHON" "$CASE_DIR/modelo_anular.py" condicoes "$q" --case "$CASE_DIR"
    ok "Condições geradas."
}

clean() {
    info "Limpando resultados e reconstruindo 0 a partir de 0.orig..."

    rm -rf processor* dynamicCode postProcessing \
        log.* *.foam 2>/dev/null || true

    find . -maxdepth 1 -type d -regextype posix-extended \
        -regex './[0-9]+(\.[0-9]+)?' -exec rm -rf {} + 2>/dev/null || true

    rm -rf 0 2>/dev/null || true

    if [[ -d 0.orig ]]; then
        cp -r 0.orig 0
    else
        err "0.orig não existe. Não é seguro executar clean."
        exit 1
    fi

    ok "Limpeza concluída."
}

mesh() {
    source_foam
    info "Gerando malha..."
    blockMesh > log.blockMesh 2>&1
    checkMesh > log.checkMesh 2>&1
    ok "Malha gerada e verificada."
}

init() {
    source_foam
    [[ -d 0 ]] || { [[ -d 0.orig ]] && cp -r 0.orig 0 || {
        err "Nem 0/ nem 0.orig/ existem."; exit 1; }; }

    [[ -f system/setFieldsDict ]] || {
        err "system/setFieldsDict não encontrado. Execute ./Allrun condicoes Q."
        exit 1
    }

    info "Aplicando setFields..."
    setFields > log.setFields 2>&1
    ok "setFields aplicado."
}

configure_solver() {
    local solver="$1"
    local nprocs="$2"

    if [[ -f system/decomposeParDict ]]; then
        foamDictionary system/decomposeParDict \
            -entry numberOfSubdomains -set "$nprocs" >/dev/null 2>&1 || true
    fi

    case "$solver" in
        gamg)
            sed -i '/petscFoam/d' system/controlDict 2>/dev/null || true
            ;;
        petsc_cpu|petsc_gpu)
            if ! grep -q "petscFoam" system/controlDict 2>/dev/null; then
                cat >> system/controlDict <<'EOF'

libs
(
    petscFoam
);
EOF
            fi
            ;;
        *)
            err "Solver inválido: $solver"
            exit 1
            ;;
    esac
}

run() {
    source_foam

    local solver="${1:-gamg}"
    local target="${2:-}"
    local nprocs="${NPROCS:-8}"

    [[ -f system/controlDict ]] || { err "system/controlDict não encontrado."; exit 1; }
    [[ -d constant/polyMesh ]] || mesh
    [[ -d 0 ]] || { [[ -d 0.orig ]] && cp -r 0.orig 0 || {
        err "0.orig não existe."; exit 1; }; }

    if [[ -n "$target" ]]; then
        foamDictionary system/controlDict -entry endTime -set "$target"
        foamDictionary system/controlDict -entry writeInterval -set "${WRITE_INTERVAL:-0.5}"
    fi

    configure_solver "$solver" "$nprocs"

    if [[ ! -d processor0 ]]; then
        info "Decompondo domínio em ${nprocs} processos..."
        decomposePar -force > log.decomposePar 2>&1
    fi

    rm -f STOP_IT
    info "Executando interIsoFoam: solver=${solver}, processos=${nprocs}"
    info "Para interromper: touch STOP_IT"

    mpirun --oversubscribe -np "$nprocs" interIsoFoam -parallel \
        > log.interIsoFoam 2>&1 &
    local pid=$!

    while kill -0 "$pid" 2>/dev/null; do
        sleep "${CHECK_INTERVAL:-30}"

        if [[ -f STOP_IT ]]; then
            warn "STOP_IT detectado. Interrompendo..."
            kill -TERM "$pid" 2>/dev/null || true
            sleep 2
            kill -KILL "$pid" 2>/dev/null || true
            rm -f STOP_IT
            break
        fi

        local current
        current=$(grep '^Time = ' log.interIsoFoam 2>/dev/null | tail -1 | awk '{print $3}' || true)
        [[ -n "$current" ]] && info "Progresso: t=${current}s"
    done

    if ! wait "$pid"; then
        err "interIsoFoam terminou com erro."
        exit 1
    fi

    info "Reconstruindo resultados..."
    reconstructPar > log.reconstructPar 2>&1 || warn "reconstructPar retornou erro."

    touch case.foam
    ok "Simulação finalizada."
}

post() {
    source_foam
    need_python

    info "Executando amostragem e análise..."
    "$PYTHON" "$CASE_DIR/analise.py" resultados
    "$PYTHON" "$CASE_DIR/analise.py" diagnostico
    ok "Pós-processamento concluído."
}

compare() {
    need_python
    "$PYTHON" "$CASE_DIR/analise.py" comparar
}

full() {
    local q="${1:-35}"
    local solver="${2:-gamg}"
    local target="${3:-}"

    info "Pipeline completo: Q=${q} L/min | solver=${solver} | tempo=${target:-controlDict}"

    condicoes "$q"
    clean
    mesh
    init

    if [[ -n "$target" ]]; then
        run "$solver" "$target"
    else
        run "$solver"
    fi

    post
    compare
    ok "PIPELINE COMPLETO FINALIZADO."
}

COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
    condicoes) condicoes "$@" ;;
    clean) clean ;;
    mesh) mesh ;;
    init) init ;;
    run) run "$@" ;;
    run5) run "${1:-gamg}" "5.0" ;;
    post) post ;;
    compare) compare ;;
    full) full "$@" ;;
    status) status ;;
    help|-h|--help) help ;;
    *) err "Comando desconhecido: $COMMAND"; help; exit 1 ;;
esac
