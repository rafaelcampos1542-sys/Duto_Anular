#!/bin/sh
cd "${0%/*}" || exit
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

# ── CONFIG ────────────────────────────────────────────────────────────────
SOLVER="gamg"   # gamg | petsc_cpu | petsc_gpu

# ── 1. Solver ─────────────────────────────────────────────────────────────
case "$SOLVER" in
    gamg)
        NPROCS=8
        echo "Usando GAMG (CPU)"
        foamDictionary system/decomposeParDict \
            -entry numberOfSubdomains -set $NPROCS
        cp system/fvSolution.gamg.bak system/fvSolution 2>/dev/null || true
        ;;
    petsc_cpu)
        NPROCS=8
        echo "Usando PETSc CPU"
        foamDictionary system/decomposeParDict \
            -entry numberOfSubdomains -set $NPROCS
        cp system/fvSolution.petsc_cpu.bak system/fvSolution 2>/dev/null || true
        ;;
    petsc_gpu)
        NPROCS=4
        echo "Usando PETSc + GPU"
        foamDictionary system/decomposeParDict \
            -entry numberOfSubdomains -set $NPROCS
        cp system/fvSolution.amgx.bak system/fvSolution 2>/dev/null || true
        export CUDA_VISIBLE_DEVICES=0
        ;;
esac

# ── 2. Limpeza ────────────────────────────────────────────────────────────
echo "Limpando caso..."
rm -rf 0 processor* constant/polyMesh log.* dynamicCode 2>/dev/null

# ── 3. Restaurar condições iniciais ───────────────────────────────────────
cp -r 0.orig 0

# ── 4. Geração de Malha ───────────────────────────────────────────────────
echo "Gerando malha..."
runApplication blockMesh
runApplication surfaceFeatureExtract
runApplication snappyHexMesh -overwrite
runApplication checkMesh

# ── 5. Limpeza de arquivos temporários do snappy ─────────────────────────
echo "Limpando arquivos temporários do snappyHexMesh..."
rm -f 0/cellLevel 0/pointLevel 0/surfaceIndex 0/level0Edge 0/cc* 2>/dev/null

# ── 6. Inicialização física ───────────────────────────────────────────────
echo "Aplicando setFields..."
runApplication setFields

# ── 7. Pré-compilação do coded BC (serial) ────────────────────────────────
echo "Pré-compilando dynamicCode/codedBC..."
interIsoFoam -postProcess > /dev/null 2>&1 || true

# ── 8. Paralelização e Execução ───────────────────────────────────────────
echo "Decompondo domínio para $NPROCS núcleos..."
runApplication decomposePar -force

echo "Rodando interIsoFoam em paralelo com $NPROCS núcleos..."
mpirun -np $NPROCS interIsoFoam -parallel > log.interIsoFoam 2>&1

# ── 9. Pós-processamento ──────────────────────────────────────────────────
echo "Reconstruindo o caso..."
runApplication reconstructPar

touch case.foam
echo "Simulação e pós-processamento finalizados com sucesso!"