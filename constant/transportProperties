FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (oil air);

oil
{
    transportModel  Newtonian;
    // Dados da Tabela 1 (Ortiz-Vidal & Fiorot, 2023):
    // mu = 0.576 Pa.s, rho ≈ 900 kg/m³  →  nu = 6.4e-04 m²/s
    nu              6.4e-04;
    rho             900;
}

air
{
    transportModel  Newtonian;
    nu              1.48e-05;
    rho             1.2;   // ligeiramente mais realista que 1
}

// Tensão superficial óleo-ar (~0.03 N/m)
// Ajuste se tiver dado experimental específico
sigma            0.03;

