FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// ************************************************************************* //

// Q = 10.00 L/min | h_L = 15.671 mm | V = 0.1961 m/s

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0 0 0);

boundaryField
{
    outlet
    {
        type            pressureInletOutletVelocity;
        value           $internalField;
    }

    parede_interna
    {
        type            noSlip;
    }

    parede_externa
    {
        type            noSlip;
    }
    inlet_oil
    {
        type            fixedValue;
        value           uniform (0 0.1961 0);
    }
    inlet_air
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

}
