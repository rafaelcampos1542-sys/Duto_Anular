FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      areaOleoMeio;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            surfaceFieldValue;
libs            ( fieldFunctionObjects );

fields          ( alpha.oil );
operation       areaIntegrate;

regionType      sampledSurface;
name            planoOleoMeio;

sampledSurfaceDict
{
    type            cuttingPlane;

    planeType       pointAndNormal;

    pointAndNormalDict
    {
        point       ( 0 0 0 );
        normal      ( 0 1 0 );
    }

    interpolate     true;
}

writeControl    writeTime;
writeFields     false;
log             true;
